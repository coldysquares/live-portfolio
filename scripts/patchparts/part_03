# Make toasts honest and route all upgrade-like actions to the project inquiry.
sub_once(
    r'        const BillingManager = \{.*?\n        \};\n\n\n        const ConsultationCalculator =',
    r'''        const BillingManager = {
            interceptExport(artifactName) { this.showToast(`${artifactName} is ready locally.`); },
            upgradeTier() { UIControls.showModal('modal-consultation'); },
            showToast(msg) {
                const toast = document.getElementById('global-action-toast'); if (!toast) return;
                toast.textContent = msg; toast.classList.remove('hidden');
                clearTimeout(this.toastTimer);
                this.toastTimer = setTimeout(() => toast.classList.add('hidden'), 3200);
            }
        };

        const ConsultationCalculator =''',
    'rewrite billing/toast manager',
)

consultation_js = r'''        const ConsultationCalculator = {
            CONTACT_EMAIL: 'nickberghane@gmail.com',
            fields: ['lead-name', 'lead-email', 'lead-org', 'lead-summary', 'lead-timing', 'lead-budget'],
            init() {
                const form = document.getElementById('consultation-form'); if (!form) return;
                this.fields.forEach(id => {
                    const el = document.getElementById(id);
                    const saved = localStorage.getItem(`lead_draft_${id}`);
                    if (el && saved !== null) el.value = saved;
                    el?.addEventListener('input', () => localStorage.setItem(`lead_draft_${id}`, el.value));
                });
                document.querySelectorAll('#scope-options input[type="checkbox"]').forEach((box, index) => {
                    box.checked = localStorage.getItem(`lead_scope_${index}`) === 'true';
                    box.addEventListener('change', () => {
                        localStorage.setItem(`lead_scope_${index}`, String(box.checked));
                        this.calculate();
                    });
                });
                this.calculate();
            },
            selectedScopes() { return [...document.querySelectorAll('#scope-options input:checked')]; },
            calculate() {
                const selected = this.selectedScopes();
                const low = selected.reduce((sum, el) => sum + (Number(el.dataset.low) || 0), 0);
                const high = selected.reduce((sum, el) => sum + (Number(el.dataset.high) || 0), 0);
                const days = selected.reduce((sum, el) => sum + (Number(el.dataset.days) || 0), 0);
                const budget = document.getElementById('lbl-calc-budget');
                const timeline = document.getElementById('lbl-calc-days');
                if (!budget || !timeline) return;
                budget.textContent = selected.length ? `$${low.toLocaleString()}–$${high.toLocaleString()}` : 'Select a scope';
                timeline.textContent = selected.length ? `${Math.max(3, Math.ceil(days * 0.65))}–${Math.max(5, days)} business days` : 'To be scoped';
            },
            buildBrief() {
                const get = id => document.getElementById(id)?.value.trim() || '';
                const scopes = this.selectedScopes().map(el => el.value);
                return {
                    name: get('lead-name'),
                    email: get('lead-email'),
                    organization: get('lead-org'),
                    summary: get('lead-summary'),
                    scopes,
                    timing: get('lead-timing'),
                    budgetContext: get('lead-budget'),
                    indicativeRange: document.getElementById('lbl-calc-budget')?.textContent || '',
                    indicativeTimeline: document.getElementById('lbl-calc-days')?.textContent || '',
                    source: window.location.href,
                    createdAt: new Date().toISOString()
                };
            },
            markdown() {
                const b = this.buildBrief();
                return `# Project inquiry\n\n**Name:** ${b.name}\n**Email:** ${b.email}\n**Organization / project:** ${b.organization || 'Not provided'}\n**Timing:** ${b.timing}\n**Budget context:** ${b.budgetContext}\n**Indicative range:** ${b.indicativeRange}\n**Indicative timeline:** ${b.indicativeTimeline}\n\n## Scope\n${b.scopes.length ? b.scopes.map(s => `- ${s}`).join('\n') : '- To be discussed'}\n\n## What needs to happen\n${b.summary}`;
            },
            async copyBrief() {
                const text = this.markdown();
                try { await navigator.clipboard.writeText(text); }
                catch (_) {
                    const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove();
                }
                BillingManager.showToast('Project brief copied.');
            },
            downloadBrief() {
                const blob = new Blob([JSON.stringify(this.buildBrief(), null, 2)], { type: 'application/json' });
                const url = URL.createObjectURL(blob); const a = document.createElement('a');
                a.href = url; a.download = `nick-berghane-project-brief-${Date.now()}.json`; document.body.appendChild(a); a.click(); a.remove();
                setTimeout(() => URL.revokeObjectURL(url), 0);
                BillingManager.showToast('Project brief downloaded.');
            },
            openEmail(event) {
                event.preventDefault();
                if (!document.getElementById('consultation-form')?.reportValidity()) return;
                const subject = encodeURIComponent(`Project inquiry — ${this.buildBrief().organization || this.buildBrief().name}`);
                const body = encodeURIComponent(this.markdown());
                window.location.href = `mailto:${this.CONTACT_EMAIL}?subject=${subject}&body=${body}`;
            }
        };

        /* --- HARDWARE-ISOLATED SINGLE PREVIEW AUDIO FREQUENCY ENGINE --- */'''
sub_once(
    r'        const ConsultationCalculator = \{.*?\n        \};\n\n        /\* --- HARDWARE-ISOLATED SINGLE PREVIEW AUDIO FREQUENCY ENGINE --- \*/',
    consultation_js,
    'replace calculator runtime with lead brief engine',
)

